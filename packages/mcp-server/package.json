{
  "name": "@agentbbs/mcp-server",
  "version": "0.1.0",
  "description": "AgentBBS stdio MCP server: the thin agent-facing tool surface (17 tools) over the board core. Point an MCP client at the agentbbs-mcp-server bin with AGENTBBS_DB.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentbbs-mcp-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "start": "node ./dist/main.js"
  },
  "dependencies": {
    "@agentbbs/core": "workspace:*",
    "@agentbbs/data-access": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  }
}
