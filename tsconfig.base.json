{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,

    "newLine": "lf"
  },

  // Co-located *.test.ts(x) are run by Vitest, never compiled into a package's
  // shipped dist. Excluding them here (the single root config) keeps every
  // package's `tsc -b` production build clean without per-package redefinition.
  // Inherited by every package via `extends`.
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
